# Public API bind configuration
WEBKIT_PORT=8080
WEBKIT_API_TOKEN=replace-with-a-long-random-token
WEBKIT_SEARXNG_URL=http://searxng:8080
WEBKIT_USER_AGENT=Web-Kit/0.1 (+https://github.com/nexus-agents/web-kit)
WEBKIT_MAX_BODY_BYTES=5242880
WEBKIT_MAX_REDIRECTS=5
WEBKIT_REQUEST_TIMEOUT_MS=12000
RUST_LOG=web_kit=info,tower_http=info

# Pin this to a reviewed SearXNG image tag for production.
SEARXNG_IMAGE=searxng/searxng:latest
SEARXNG_BASE_URL=http://localhost:8080/
SEARXNG_INSTANCE_NAME=Web-Kit Search
